# Khóa API Gemini từ Google AI Studio (https://aistudio.google.com)
# Bắt buộc đặt ở môi trường máy chủ, không lưu vào client / trình duyệt
GEMINI_API_KEY=your_gemini_api_key_here

# Mô hình Gemini (mặc định gemini-flash-latest, có thể đổi sang gemini-3.1-pro-preview)
GEMINI_MODEL=gemini-flash-latest

# Cổng khởi chạy máy chủ Express (mặc định 3000)
PORT=3000
